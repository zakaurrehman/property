# ── Public site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Estate Bureau"
NEXT_PUBLIC_WHATSAPP_NUMBER=+923000000000
NEXT_PUBLIC_CONTACT_PHONE=+924235000000
NEXT_PUBLIC_CONTACT_EMAIL=info@estatebureau.pk

# ── Database — Postgres ──────────────────────────────────────────────────
# For local dev, run `pnpm db:dev` once (starts a local Prisma Postgres via
# `prisma dev` and prints a connection string — copy its TCP url here). For
# production, point this at Neon/Supabase/Prisma Postgres instead.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ── Auth.js — wired in Phase 6 ──────────────────────────────────────────────
AUTH_SECRET=  # generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email — Resend, wired in Phase 5 ────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@estatebureau.pk

# ── Media uploads — Cloudinary, wired in Phase 6 ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate limiting — Upstash Redis, wired in Phase 5 ─────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection — Cloudflare Turnstile, wired in Phase 5 ─────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Maps — MapLibre style URL, wired in Phase 4 ─────────────────────────────
NEXT_PUBLIC_MAP_TILES_URL=https://demotiles.maplibre.org/style.json

# ── FX rates for overseas currency toggle (admin-editable in Phase 7+) ─────
FX_USD_PER_PKR=0.0036
FX_GBP_PER_PKR=0.0028
FX_AED_PER_PKR=0.013

# ── Property advisor chat — LLM key, wired in Phase 5 ───────────────────────
CHAT_LLM_API_KEY=
