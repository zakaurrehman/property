# Only DATABASE_URL is required. Every other variable can be omitted OR left
# blank (e.g. saved with an empty value on Vercel) — blank is treated as unset
# and the documented default / graceful fallback applies.

# ── Public site ──────────────────────────────────────────────────────────
# Public origin for canonical/hreflang/sitemap/JSON-LD URLs and email links.
# On Vercel this may be left blank: the server falls back to
# VERCEL_PROJECT_PRODUCTION_URL. Set it once you're on a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Estate Bureau"
NEXT_PUBLIC_WHATSAPP_NUMBER=+923211199719
NEXT_PUBLIC_CONTACT_PHONE=+923211199719
NEXT_PUBLIC_CONTACT_EMAIL=dhaestatebureau@gmail.com

# ── Database — Postgres ──────────────────────────────────────────────────
# For local dev, run `pnpm db:dev` once (starts a local Prisma Postgres via
# `prisma dev` and prints a connection string — copy its TCP url here). For
# production, point this at Neon/Supabase/Prisma Postgres instead.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# `prisma dev` provisions a dedicated shadow-db instance and prints its own
# connection string (usually one port up) — used by `prisma migrate dev` to
# diff schema changes without touching the shadow db. Without this, Prisma
# auto-provisions a shadow db that clones Postgres's own "template1", which
# already holds our schema (since DATABASE_URL points at a db named
# "template1" too) and migrations fail with "type already exists".
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ── Auth.js — Credentials always works; Google is optional (omit both ─────
# AUTH_GOOGLE_* vars and the provider is skipped, see lib/auth/config.ts)
# REQUIRED on every host: a blank value fails the build on purpose, because
# Auth.js would otherwise 500 on every /api/auth/* request in production.
AUTH_SECRET=  # generate with: npx auth secret — a dev value ships in .env
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email — Resend (lib/email.ts logs and skips sending if unset) ──────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@estatebureau.pk

# ── Media uploads — Cloudinary (lib/cloudinary.ts). The agent listing wizard
# falls back to pasting image URLs when these are unset, so this is optional
# for local dev too.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate limiting — Upstash Redis (lib/rate-limit.ts falls back to an ──────
# in-memory limiter if unset, so this is optional for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection — Cloudflare Turnstile, not wired up yet ─────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Maps — raster tile URL template ({z}/{x}/{y}), see src/features/map/style.ts
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ── FX rates for overseas currency toggle (admin-editable in Phase 7+) ─────
FX_USD_PER_PKR=0.0036
FX_GBP_PER_PKR=0.0028
FX_AED_PER_PKR=0.013

# ── Property advisor chat — the quick-reply chip flow works without this;
# only needed for free-text LLM-grounded answers (/api/chat), not wired up yet
CHAT_LLM_API_KEY=
